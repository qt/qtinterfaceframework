{% import 'common/qtif_macros.jinja' as qtif %}
{% include "common/generated_comment.cpp.jinja" %}
{% set class = '{0}MqttBackend'.format(interface) %}
{% set zone_class = '{0}MqttZone'.format(interface) %}
{% set interface_zoned = interface.tags.config and interface.tags.config.zoned %}
{% set oncedefine = '{0}_{1}_H_'.format(module.module_name|upper, class|upper) %}
#ifndef {{oncedefine}}
#define {{oncedefine}}

#include <QMqttClient>
#include <QBitArray>

#include <optional>
{% if module.tags.config.module %}
#include <{{module.tags.config.module}}/{{interface}}BackendInterface>
{% else %}
#include "{{interface|lower}}backendinterface.h"
{% endif %}

using namespace Qt::StringLiterals;

{{ module|begin_namespace }}

{% if interface_zoned %}
class {{class}};

class {{zone_class}} : public QObject
{
    Q_OBJECT

public:
    explicit {{zone_class}}(const QString &zone, {{class}} *parent = nullptr);

    bool isSyncing() const;
    QStringList propertiesToSync() const;
    void emitCurrentState();

public Q_SLOTS:
{% for property in interface.properties %}
{%   if not property.is_model %}
    {{qtif.prop_setter(property)}};
{%   endif %}
{% endfor %}

Q_SIGNALS:
    void syncDone();

private:
    void checkSync();

    {{class}} *m_parent;
    QString m_zone;
{% for property in interface.properties %}
{%   if not property.is_model %}
    {{ property|return_type }} m_{{ property }};
{%   endif %}
{% endfor %}
    QStringList m_propertiesToSync;
};
{% endif %}

class {{class}} : public {{interface}}BackendInterface
{
    Q_OBJECT

public:
    explicit {{class}}(const QString &topicPrefix = {}, QObject *parent = nullptr);
    ~{{class}}() override;

    void initialize() override;
    void updateServiceSettings(const QVariantMap &settings);

public Q_SLOTS:
{% for property in interface.properties %}
{%   if not property.is_model %}
{%     if not property.readonly and not property.const %}
    {{qtif.prop_setter(property, zoned=interface_zoned)}} override;
{%     elif property|mqtt_reset_on_error %}
    {{qtif.prop_setter(property, zoned=interface_zoned)}};
{%     endif %}
{%   endif %}
{% endfor %}

{% if interface_zoned %}
    QStringList availableZones() const override;
{% endif %}

{% for operation in interface.operations %}
    {{qtif.operation(operation, zoned=interface_zoned)}} override;
{% endfor %}

protected Q_SLOTS:
    void onMessageReceived(const QByteArray &message, const QMqttTopicName &topic);
{% for property in interface.properties %}
{%   if not property.is_model %}
    {{qtif.on_prop_changed(property, zoned=interface_zoned)}};
{%   endif %}
{% endfor %}

protected:
    bool connectToBroker();
    QString mqttTopic(const QString &topic, bool usePrefix) const;
    void checkSyncDone();
{% if interface_zoned %}
    QString zonedSymbol(const QString &symbol, const QString &zone) const;
    std::optional<QString> matchZonedTopic(const QMqttTopicName &topic, const QString &symbol, bool usePrefix) const;
{% endif %}

    QMqttClient *m_client = nullptr;
    QUrl m_url;
    QString m_topicPrefix;
    QHash<QString, std::function<void (const QByteArray &)> > m_pendingReplies;
    QVariantMap m_serviceSettings;
{% if interface_zoned %}
    bool m_zonesReceived = false;
    bool m_synced = false;
    QHash<QString, {{zone_class}}*> m_zoneMap;
    QStringList m_zones;

    friend class {{zone_class}};
{% else %}
{% for property in interface.properties %}
{%     if not property.type.is_model %}
    {{ property|return_type }} m_{{ property }};
{%     endif %}
{% endfor %}
    QStringList m_propertiesToSync;
{% endif %}
};

{{ module|end_namespace }}

#endif // {{oncedefine}}
