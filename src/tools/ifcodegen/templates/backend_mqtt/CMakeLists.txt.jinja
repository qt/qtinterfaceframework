{% include "common/generated_comment.cmake.jinja" %}

if (NOT TARGET Qt6::Mqtt)
    find_package(Qt6 COMPONENTS Mqtt)
endif()

qt6_set_ifcodegen_variable(${VAR_PREFIX}_SOURCES
{% for interface in module.interfaces %}
    ${CMAKE_CURRENT_LIST_DIR}/{{interface|lower}}mqttbackend.h
    ${CMAKE_CURRENT_LIST_DIR}/{{interface|lower}}mqttbackend.cpp
{% endfor %}
    ${CMAKE_CURRENT_LIST_DIR}/{{module.module_name|lower}}_mqtt_helper.h
    ${CMAKE_CURRENT_LIST_DIR}/{{module.module_name|lower}}_mqtt_helper.cpp
    ${CMAKE_CURRENT_LIST_DIR}/{{module.module_name|lower}}mqttplugin.h
    ${CMAKE_CURRENT_LIST_DIR}/{{module.module_name|lower}}mqttplugin.cpp
)

qt6_set_ifcodegen_variable(${VAR_PREFIX}_LIBRARIES
    Qt6::InterfaceFramework
    Qt6::Mqtt
)

qt6_set_ifcodegen_variable(${VAR_PREFIX}_PLUGIN_CLASS_NAME
    {{module.module_name|upperfirst}}MqttPlugin
)

if (TARGET ${CURRENT_TARGET})
    target_sources(${CURRENT_TARGET}
                   PRIVATE
        ${${VAR_PREFIX}_SOURCES}
    )

    target_link_libraries(${CURRENT_TARGET} PRIVATE
        ${${VAR_PREFIX}_LIBRARIES}
    )

    target_include_directories(${CURRENT_TARGET} PRIVATE
        $<BUILD_INTERFACE:${CMAKE_CURRENT_LIST_DIR}>
        $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}>
    )
endif()
