QByteArray toMqttMessage(const QVariant &value)
{
    if (value.canConvert<QByteArray>()) {
        QVariant v = value;
        v.convert(QMetaType::fromType<QByteArray>());
        return v.toByteArray();
    }

    QByteArray data;
    QDataStream stream(data);
    stream << value;
    return data;
}

QByteArray toMqttMessage(const QVariantList &value)
{
    QByteArray data;
    QDataStream stream(data);
    stream << value;
    return data;
}

QByteArray toMqttMessage(bool value)
{
    return QJsonDocument::fromVariant(QVariant::fromValue(value)).toJson(QJsonDocument::Compact);
}

QByteArray toMqttMessage(const QList<bool> &value)
{
    QVariantList list;
    for (auto val : value)
        list.append(val);
    return QJsonDocument::fromVariant(list).toJson(QJsonDocument::Compact);
}

QByteArray toMqttMessage(double value)
{
    return QByteArray::number(value, 10, QLocale::FloatingPointShortest);
}

QByteArray toMqttMessage(const QList<double> &value)
{
    QVariantList list;
    for (auto val : value)
        list.append(val);
    return QJsonDocument::fromVariant(list).toJson(QJsonDocument::Compact);
}

QByteArray toMqttMessage(int value)
{
    return QByteArray::number(value);
}

QByteArray toMqttMessage(const QList<int> &value)
{
    QVariantList list;
