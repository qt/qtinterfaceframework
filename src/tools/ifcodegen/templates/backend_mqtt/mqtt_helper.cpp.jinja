{% for enum in module.enums %}
template <> {{module.module_name|upper_first}}::{{enum|flag_type}} fromMqttMessage(const QVariant &value, bool *ok)
{
    QVariant convertedValue = value;
    bool success = !convertedValue.canConvert<{{module.module_name|upper_first}}::{{enum|flag_type}}>() && !convertedValue.convert(QMetaType::fromType<{{module.module_name|upper_first}}::{{enum|flag_type}}>());
    if (ok)
        *ok = success;
    {{module.module_name|upper_first}}::{{enum|flag_type}} enumValue = {{module.module_name|upper_first}}::to{{enum|flag_type}}(convertedValue.toUInt(), ok);
    return enumValue;
}
template <> {{module.module_name|upper_first}}::{{enum|flag_type}} fromMqttMessage(const QByteArray &message, bool *ok)
{
    QVariant value = QVariant::fromValue(message);
    return fromMqttMessage<{{module.module_name|upper_first}}::{{enum|flag_type}}>(value, ok);
}
