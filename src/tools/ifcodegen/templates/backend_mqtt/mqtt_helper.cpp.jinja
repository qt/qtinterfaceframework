template <> QVariant fromMqttMessage(const QByteArray &message, bool *ok)
{
    QVariant value = QVariant::fromValue(message);
    if (ok)
        *ok = true;
    return value;
}

{% for type in ("bool", "int", "float", "QString", "QVariant") %}
template <> QList<{{type}}> fromMqttMessage(const QByteArray &message, bool *ok)
{
    QList<{{type}}> list;
    const QJsonDocument doc = QJsonDocument::fromJson(message);
    if (!doc.isArray())
        return {};

    for (auto &value : doc.toVariant().toList()) {
        bool val_ok = false;
        list.append(fromMqttMessage<{{type}}>(value, &val_ok));

        if (!val_ok)
            return {};
    }
    if (ok)
        *ok = true;

    return list;
}
{% endfor %}

