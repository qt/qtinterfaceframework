    return QJsonDocument::fromVariant(list).toJson(QJsonDocument::Compact);
}

QByteArray toMqttMessage(const QString &value)
{
    return value.toUtf8();
}

QByteArray toMqttMessage(const QList<QString> &value)
{
    QVariantList list;
    for (auto &val : value)
        list.append(val);
    return QJsonDocument::fromVariant(list).toJson(QJsonDocument::Compact);
}

